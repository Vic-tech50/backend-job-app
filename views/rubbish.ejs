<%= stats.totalUploads || 0 %>
 <%= stats.pendingJobs || 0 %>
  <%# <%= stats.completedJobs || 0 %> %>
     <%#  <%= stats.totalJobs || 0 %>  #%>
     \
       <% if (workUploads && workUploads.length > 0) { %>

                        <div class="row">

                            <% workUploads.forEach(work => { %>

                                <div class="col-md-6 col-xl-4 mb-4">
                                    <div class="portfolio-card">

                                        <a
                                            href="/uploads/<%= work.image %>"
                                            target="_blank"
                                        >
                                            <img
                                                src="/uploads/<%= work.image %>"
                                                alt="<%= work.title || 'Artisan work' %>"
                                                class="portfolio-image"
                                            >
                                        </a>

                                        <div class="p-3">
                                            <h6 class="font-weight-700 mb-1">
                                                <%= work.title || "Untitled Work" %>
                                            </h6>

                                            <p class="text-muted small mb-2">
                                                <%= work.description || "No description provided." %>
                                            </p>

                                            <small class="text-muted">
                                                <i class="fa fa-calendar mr-1"></i>
                                                <%= work.created_at
                                                    ? new Date(work.created_at).toLocaleDateString()
                                                    : "Date unavailable" %>
                                            </small>
                                        </div>

                                    </div>
                                </div>

                            <% }) %>

                        </div>

                    <% } else { %>

                        <div class="empty-state">
                            <i class="fa fa-picture-o"></i>
                            <h6>No Work Uploads Yet</h6>
                            <p>This artisan has not uploaded any portfolio samples.</p>
                        </div>

                    <% } %>

                     <%= workUploads.length %>








                        <!-- COMPLETED JOBS -->
                <div class="card-box pd-25">

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h5 class="font-weight-700 mb-1">
                                <i class="fa fa-check-circle text-success mr-2"></i>
                                Completed Jobs
                            </h5>
                            <small class="text-muted">
                                Jobs successfully completed by this artisan.
                            </small>
                        </div>

                        <span class="badge badge-success">
                            <%= completedJobs.length %> Completed
                        </span>
                    </div>

                    <% if (completedJobs && completedJobs.length > 0) { %>

                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Job Details</th>
                                        <th>Customer</th>
                                        <th>Amount</th>
                                        <th>Completed</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    <% completedJobs.forEach(job => { %>

                                        <tr>
                                            <td>
                                                <strong>
                                                    <%= job.job_title || job.title || "Untitled Job" %>
                                                </strong>

                                                <br>

                                                <small class="text-muted">
                                                    Job #<%= job.id %>
                                                </small>
                                            </td>

                                            <td>
                                                <%= job.customer_name || "Unknown Customer" %>
                                            </td>

                                            <td>
                                                <strong>
                                                    ₦<%= Number(job.amount || 0).toLocaleString() %>
                                                </strong>
                                            </td>

                                            <td>
                                                <%= job.completed_at
                                                    ? new Date(job.completed_at).toLocaleDateString()
                                                    : "Not available" %>
                                            </td>

                                            <td>
                                                <span class="badge badge-success">
                                                    <i class="fa fa-check"></i> Completed
                                                </span>
                                            </td>
                                        </tr>

                                    <% }) %>

                                </tbody>
                            </table>
                        </div>

                    <% } else { %>

                        <div class="empty-state">
                            <i class="fa fa-briefcase"></i>
                            <h6>No Completed Jobs</h6>
                            <p>This artisan has no completed jobs yet.</p>
                        </div>

                    <% } %>

                </div>

                <p class="text-muted mb-2">
                        <i class="fa fa-phone mr-2"></i>
                        <%= artisan.phone || "No phone number" %>
                    </p>

                    <p class="text-muted mb-0">
                        <i class="fa fa-map-marker mr-2"></i>
                        <%= artisan.city || artisan.location || "Location unavailable" %>
                    </p>